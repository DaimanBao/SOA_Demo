# PostgreSQL running on the host. Replace user/password with your local credentials.
DATABASE_URL=postgresql://postgres:change_me@localhost:5433/auth_db?schema=public
PORT=3001
SINHVIEN_SERVICE_URL=http://localhost:3002

# Generate one strong secret and use the same value in every service.
JWT_SECRET=replace_with_the_same_random_secret_in_all_services
JWT_EXPIRES_IN=2h

# One-time admin bootstrap secret; generate a random value of at least 32 characters.
ADMIN_BOOTSTRAP_SECRET=replace_with_a_random_bootstrap_secret_of_at_least_32_characters
